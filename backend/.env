# ── Application ───────────────────────────────────────────────────────────────
APP_NAME=FreightFlex API
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=True
API_PREFIX=/api/v1

# ── Server ────────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
WORKERS=1

# ── CORS ──────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:3001","http://localhost:8081"]

# ── Database (MySQL 8.0) ──────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_NAME=freightflex
DB_USER=root123
DB_PASSWORD=freightflex_pass
DB_CHARSET=utf8mb4

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# ── JWT Authentication ────────────────────────────────────────────────────────
JWT_ALGORITHM=RS256
JWT_PRIVATE_KEY=""
JWT_PUBLIC_KEY=""
ACCESS_TOKEN_EXPIRE_HOURS=24
REFRESH_TOKEN_EXPIRE_DAYS=30

# ── Bcrypt ────────────────────────────────────────────────────────────────────
BCRYPT_ROUNDS=12

# ── AWS S3 ────────────────────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
AWS_S3_BUCKET_DOCS=freightflex-docs
AWS_S3_BUCKET_PHOTOS=freightflex-photos
AWS_S3_BUCKET_INVOICES=freightflex-invoices
AWS_S3_PRESIGNED_URL_EXPIRY=604800

# ── Google Maps Platform ──────────────────────────────────────────────────────
GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_BASE_URL=https://maps.googleapis.com/maps/api

# ── Payment Gateway (Razorpay) ────────────────────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
PAYMENT_CURRENCY=INR

# ── SendGrid (Email) ──────────────────────────────────────────────────────────
SENDGRID_API_KEY=
EMAIL_FROM=noreply@freightflex.io
EMAIL_FROM_NAME=FreightFlex

# ── Firebase Cloud Messaging ──────────────────────────────────────────────────
FCM_SERVER_KEY=
FCM_BASE_URL=https://fcm.googleapis.com/fcm/send

# ── Celery ────────────────────────────────────────────────────────────────────
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_LOGIN=10
RATE_LIMIT_LOGIN_WINDOW=900
RATE_LIMIT_FORGOT_PASSWORD=3
RATE_LIMIT_FORGOT_PASSWORD_WINDOW=3600
RATE_LIMIT_DEFAULT=300
RATE_LIMIT_DEFAULT_WINDOW=60

# ── GPS Tracking ──────────────────────────────────────────────────────────────
GPS_UPDATE_INTERVAL_SECONDS=15
GPS_TRACKING_RETENTION_DAYS=90
ETA_DELAY_ALERT_MINUTES=30

# ── Matching ──────────────────────────────────────────────────────────────────
MATCHING_RADIUS_KM=100
MATCHING_MAX_RESULTS=20

# ── File Upload ───────────────────────────────────────────────────────────────
MAX_UPLOAD_SIZE_MB=10

# ── Pagination ────────────────────────────────────────────────────────────────
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# ── Invoice ───────────────────────────────────────────────────────────────────
GST_RATE=0.18

# ── Frontend URLs ─────────────────────────────────────────────────────────────
FRONTEND_WEB_URL=http://localhost:3000
FRONTEND_MOBILE_DEEP_LINK=freightflex://

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=json

# ── Sentry ────────────────────────────────────────────────────────────────────
SENTRY_DSN=