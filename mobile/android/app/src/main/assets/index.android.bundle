d[5]).shadow.opacity,shadowRadius:r(d[5]).shadow.radius,elevation:2},sectionTitle:{color:r(d[5]).colors.navy,fontSize:15,fontWeight:'900',marginBottom:10,letterSpacing:.2},body:{color:r(d[5]).colors.ink,fontSize:13,lineHeight:20},subSection:{marginTop:14},subSectionTitle:{color:r(d[5]).colors.navy,fontSize:13,fontWeight:'800',marginBottom:6},bulletRow:{flexDirection:'row',alignItems:'flex-start',gap:8,marginTop:5},bulletDot:{color:r(d[5]).colors.accent,fontSize:14,fontWeight:'900',marginTop:1,flexShrink:0},bulletText:{flex:1,color:r(d[5]).colors.ink,fontSize:13,lineHeight:19},definitionList:{marginTop:10,gap:8},definitionRow:{borderLeftWidth:2,borderLeftColor:r(d[5]).colors.accent,paddingLeft:10,paddingVertical:2},definitionTerm:{color:r(d[5]).colors.navy,fontSize:12,fontWeight:'800',marginBottom:2},definitionDesc:{color:r(d[5]).colors.ink,fontSize:12,lineHeight:18},generalRow:{marginTop:10},generalHeading:{color:r(d[5]).colors.navy,fontSize:13,fontWeight:'800',marginBottom:2},generalText:{color:r(d[5]).colors.ink,fontSize:13,lineHeight:19},footer:{marginTop:r(d[5]).spacing.lg,borderTopWidth:1,borderTopColor:r(d[5]).colors.border,paddingTop:r(d[5]).spacing.xl,alignItems:'center',gap:6},footerAgreement:{color:r(d[5]).colors.ink,fontSize:13,lineHeight:20,textAlign:'center',fontWeight:'600',marginBottom:8},footerCompany:{color:r(d[5]).colors.navy,fontSize:12,fontWeight:'800'},footerVersion:{color:r(d[5]).colors.inkSoft,fontSize:11}});e.default=function(t){var p=t.onBack;return(0,s.jsxs)(o.ScrollView,{style:f.container,contentContainerStyle:f.content,showsVerticalScrollIndicator:!1,children:[p?(0,s.jsxs)(o.Pressable,{onPress:p,style:f.backBtn,children:[(0,s.jsx)(o.Text,{style:f.backArrow,children:"\u2190"}),(0,s.jsx)(o.Text,{style:f.backText,children:"Back"})]}):null,(0,s.jsxs)(o.View,{style:f.header,children:[(0,s.jsx)(o.Text,{style:f.tag,children:"LOGISTICS \xb7 RESCHEDULED"}),(0,s.jsx)(o.Text,{style:f.title,children:"Terms and Conditions of Use"}),(0,s.jsxs)(o.View,{style:f.metaBlock,children:[(0,s.jsx)(o.Text,{style:f.metaLine,children:"Version 3.0  \u2022  Effective: May 2026"}),(0,s.jsx)(o.Text,{style:f.metaLine,children:"Applies in: United Kingdom \u2022 Norway \u2022 Sweden"}),(0,s.jsx)(o.Text,{style:f.metaLine,children:"Available in Norwegian and Swedish on request"}),(0,s.jsx)(o.Text,{style:f.metaLine,children:"Tilgjengelig p\xe5 norsk p\xe5 foresp\xf8rsel"}),(0,s.jsx)(o.Text,{style:f.metaLine,children:"Tillg\xe4nglig p\xe5 svenska p\xe5 beg\xe4ran"})]}),(0,s.jsx)(o.View,{style:f.noticeBanner,children:(0,s.jsx)(o.Text,{style:f.noticeText,children:"By registering or using the Platform in any capacity, you agree to be legally bound by these Terms. If you do not agree, you must not use the Platform."})})]}),(0,s.jsxs)(l,{title:"1. Definitions",children:[(0,s.jsx)(c,{children:"Key terms used in these Terms have the following meanings:"}),(0,s.jsx)(o.View,{style:f.definitionList,children:[['"FlexiShift", "we", "us", "our"','FlexiShift Ltd, operator of the Platform.'],['"Platform"','The FlexiShift logistics marketplace, including the Haulier web app, Driver mobile app, Firm portal, and all supporting software and infrastructure.'],['"User"','Any Haulier, Driver, or Firm accessing or using the Platform.'],['"Haulier"','A business or individual posting freight jobs on the Platform.'],['"Driver"','An individual who executes jobs via the Driver mobile application.'],['"Firm"','A transport business managing fleets and Drivers on the Platform.'],['"Supplier"','Any verified Driver or Firm eligible to accept jobs.'],['"Job"','A freight task posted by a Haulier, assigned a unique Job Reference ID.'],['"Job Contract"','The binding agreement formed between Haulier and Supplier on booking confirmation, incorporating Section 5 below.'],['"Escrow Vault"','The secure payment holding facility managed by the Third-Party Payment Processor.'],['"Third-Party Payment Processor"','The specialist payment provider engaged by FlexiShift to handle all financial transactions.'],['"Compliance Track"','The mandatory three-stage workflow: Load Code Confirmation, Dual Sign-off Handover, and Delivery Proof.'],['"Prohibited Goods"','Goods listed in Section 6 that may not be carried via the Platform.'],['"Applicable Law"','The law of the jurisdiction in which the User is established or the Job is performed, as relevant.']].map(function(t){var l=(0,n.default)(t,2),c=l[0],h=l[1];return(0,s.jsxs)(o.View,{style:f.definitionRow,children:[(0,s.jsx)(o.Text,{style:f.definitionTerm,children:c}),(0,s.jsx)(o.Text,{style:f.definitionDesc,children:h})]},c)})})]}),(0,s.jsx)(l,{title:"2. Acceptance, Eligibility, and Account Security",children:(0,s.jsx)(c,{children:"By using the Platform you confirm you are at least 18 years old, have legal capacity to contract, and (if acting on behalf of a company) have authority to bind that entity. You must comply with all Applicable Laws and keep your account credentials confidential. Notify us immediately of any suspected unauthorised access."})}),(0,s.jsx)(l,{title:"3. FlexiShift's Role \u2013 Marketplace Only",children:(0,s.jsx)(c,{children:"FlexiShift is a technology marketplace intermediary only. We are not a haulage company, carrier, transport operator, or employer of any Driver or Supplier. The Job Contract is formed directly between the Haulier and Supplier. FlexiShift is not a party to it, does not direct how Jobs are performed, and makes no guarantee that Jobs will be matched, accepted, or completed."})}),(0,s.jsxs)(l,{title:"4. Verification, Identity Checks, and Fraud Prevention",children:[(0,s.jsx)(c,{children:"All Suppliers must complete mandatory verification before accepting any Job. Required documents include:"}),(0,s.jsx)(u,{children:"Driving Licence (Drivers); Vehicle Registration; current Insurance Document."}),(0,s.jsx)(u,{children:"Company Registration and Fleet Insurance policy (Firms)."}),(0,s.jsx)(u,{children:"Any other documentation required by locality."}),(0,s.jsxs)(c,{children:['\n',"FlexiShift may at any time conduct KYC (identity), KYB (business), sanctions screening, anti-fraud, and anti-money-laundering checks. We reserve the right to suspend or terminate accounts without prior notice where a User fails verification, appears on a sanctions list, or where we have reasonable grounds to suspect fraudulent, money-laundering, or criminal activity. We may refer concerns to relevant authorities without notifying the User. Duplicate email registrations are automatically blocked."]})]}),(0,s.jsxs)(l,{title:"5. Job Contract Terms (Incorporated into Every Booking)",children:[(0,s.jsx)(c,{children:"These terms apply between Haulier and Supplier for every Job unless expressly varied in writing. FlexiShift is not a party to any Job Contract."}),(0,s.jsx)(h,{title:"5.1 Loading, Unloading and Goods Verification",children:(0,s.jsx)(c,{children:"Unless otherwise agreed: the Haulier's consignor is responsible for loading; the Driver is responsible for unloading. Special equipment requirements (tail-lift, pallet truck, etc.) must be declared at job creation. On collection, the Driver must verify and record quantity, external packaging condition, and any declared special handling. Drivers are not required to open sealed packaging and bear no liability for undeclared contents. Any discrepancy must be recorded in the app at the time of handover."})}),(0,s.jsx)(h,{title:"5.2 Risk Transfer",children:(0,s.jsx)(c,{children:"Risk in the goods passes to the Supplier on successful Load Code Confirmation and reverts to the Haulier on Haulier approval of Delivery Proof."})}),(0,s.jsx)(h,{title:"5.3 Rescheduling and Incomplete Jobs",children:(0,s.jsx)(c,{children:"Rescheduling requires mutual written agreement via the Platform. If a Supplier commences but cannot complete a Job, they must immediately notify the Haulier via the Platform. Payment is determined by the dispute outcome under Section 10. FlexiShift accepts no financial liability for incomplete jobs."})}),(0,s.jsxs)(h,{title:"5.4 Proof of Delivery and Dispute Evidence",children:[(0,s.jsx)(c,{children:"Valid Delivery Proof requires: a clear photograph of goods at the delivery point; recipient digital signature; and Platform-recorded timestamp and geo-location. In any dispute, evidence is assessed in this priority order:"}),(0,s.jsx)(u,{children:"(1) Compliance Track records"}),(0,s.jsx)(u,{children:"(2) GPS/telematics data"}),(0,s.jsx)(u,{children:"(3) Timestamped app photographs and signatures"}),(0,s.jsx)(u,{children:"(4) Platform messaging logs"}),(0,s.jsx)(u,{children:"(5) Third-party documents"}),(0,s.jsx)(u,{children:"(6) Witness statements"}),(0,s.jsxs)(c,{children:['\n',"FlexiShift may share Platform data with insurers, legal representatives, law enforcement, or arbitrators on request."]})]})]}),(0,s.jsxs)(l,{title:"6. Prohibited and Restricted Goods",children:[(0,s.jsx)(c,{children:"Posting or transporting Prohibited Goods may result in immediate account suspension and referral to authorities. Suppliers may refuse any load they reasonably suspect to be prohibited, without penalty."}),(0,s.jsxs)(h,{title:"6.1 Absolutely Prohibited (no exceptions)",children:[(0,s.jsx)(u,{children:"Illegal goods, stolen property, or goods involved in any criminal activity."}),(0,s.jsx)(u,{children:"Firearms, weapons, ammunition, or explosives (licensed or otherwise)."}),(0,s.jsx)(u,{children:"Controlled drugs and controlled substances."}),(0,s.jsx)(u,{children:"Cash, bearer instruments, or high-value negotiables."}),(0,s.jsx)(u,{children:"Goods subject to international sanctions or embargoes."}),(0,s.jsx)(u,{children:"Category A/B infectious substances; unauthorised human remains or biological material."})]}),(0,s.jsxs)(h,{title:"6.2 Restricted \u2013 Requires Full Pre-Declaration and Supplier Acceptance",children:[(0,s.jsx)(u,{children:"Hazardous materials (ADR / applicable national regulations): flammable, corrosive, toxic, oxidising, or radioactive."}),(0,s.jsx)(u,{children:"Temperature-controlled or cold-chain goods."}),(0,s.jsx)(u,{children:"Livestock or live animals."}),(0,s.jsx)(u,{children:"Alcohol and tobacco subject to licensing or duty requirements."}),(0,s.jsx)(u,{children:"Oversized or overweight loads requiring permits or escort vehicles."}),(0,s.jsx)(u,{children:"Waste or environmentally regulated materials."}),(0,s.jsx)(u,{children:"High-value or fragile goods with declared value exceeding \xa310,000 / NOK 130,000 / SEK 140,000 per consignment."}),(0,s.jsx)(u,{children:"Pharmaceutical products, controlled-temperature medicines, or medical devices."})]}),(0,s.jsxs)(c,{children:['\n',"The Haulier is solely responsible for accurate goods declaration. FlexiShift does not inspect goods and accepts no liability for any loss, regulatory action, or criminal proceedings arising from undeclared or misdescribed loads."]})]}),(0,s.jsxs)(l,{title:"7. Liability Exclusions \u2013 Vehicles, Goods, Theft, and Cybersecurity",children:[(0,s.jsx)(h,{title:"7.1 Vehicle Damage",children:(0,s.jsx)(c,{children:"FlexiShift excludes all liability for loss, damage, or destruction of any vehicle used in connection with a Job, howsoever caused. Every Driver and Firm must maintain valid commercial motor insurance (covering third-party liability, goods in transit, and vehicle damage) at all times. Every Haulier must maintain adequate commercial insurance for their freight activities. FlexiShift may request evidence of insurance at any time; failure to provide it is a material breach of these Terms."})}),(0,s.jsx)(h,{title:"7.2 Theft, Product Loss, and Driver Misconduct",children:(0,s.jsx)(c,{children:"FlexiShift excludes all liability for theft, misappropriation, conversion, or misdelivery of goods by any Driver, Firm employee, or sub-contractor. Drivers and Firms are independent contractors; FlexiShift bears no vicarious liability for their conduct. Claims must be directed to the relevant Supplier or their insurer. Hauliers are responsible for maintaining adequate goods-in-transit insurance before handing over any goods."})}),(0,s.jsx)(h,{title:"7.3 Cybersecurity and Force Majeure",children:(0,s.jsx)(c,{children:"FlexiShift implements proportionate security measures but does not guarantee the Platform will be free from cyber-attacks, hacking, malware, or data breaches. FlexiShift is not liable for losses arising from third-party cyber-attacks, network failures, or force majeure events (including acts of God, natural disasters, or government action). Because payment data is handled exclusively by the Third-Party Payment Processor, FlexiShift accepts no liability for any compromise of payment information at that level. Users are responsible for securing their own devices and credentials."})}),(0,s.jsx)(h,{title:"7.4 ETA, Maps, and Route Data",children:(0,s.jsx)(c,{children:"ETA calculations, GPS tracking, route suggestions, and deviation alerts are tools and estimates only \u2014 not guarantees. Map data is sourced from third-party providers. FlexiShift accepts no liability for inaccuracies in matching results, ETA estimates, GPS data, or navigation information. Drivers must comply with road signs and traffic law regardless of any in-app route suggestion."})})]}),(0,s.jsxs)(l,{title:"8. Payments, Fees, Tax, and Invoicing",children:[(0,s.jsx)(c,{children:"All transactions are processed exclusively by the Third-Party Payment Processor. FlexiShift does not store or handle payment card or banking credentials. Accepted payment channels include those published on the Platform (including UPI, credit card, and bank transfer where available). Escrow funds are locked on booking and released to the Supplier upon Haulier approval of Delivery Proof."}),(0,s.jsxs)(c,{children:['\n',"Platform commission and service fees are as published in the Platform fee schedule (updated from time to time with reasonable notice) and are quoted exclusive of applicable sales tax."]}),(0,s.jsxs)(c,{children:['\n',"Platform fees are payable, and non-refundable, as soon as a trip or shift has started, regardless of any disputes or the outcome."]}),(0,s.jsxs)(c,{children:['\n',"Sales tax applies as follows: VAT (UK), MVA/merverdiavgift (Norway), and MOMS/merv\xe4rdesskatt (Sweden), each at the prevailing rate in the applicable jurisdiction."]}),(0,s.jsxs)(c,{children:['\n',"Each User is solely responsible for their own tax compliance, including registration, reporting, and payment of applicable taxes on income earned or services received through the Platform."]}),(0,s.jsxs)(c,{children:['\n',"Automated invoices generated by the Platform are provided for informational convenience only. FlexiShift does not act as a VAT agent, tax agent, or fiscal representative for any User."]}),(0,s.jsxs)(c,{children:['\n',"Platform commission is non-refundable on cancellations once transit has commenced and on disputed jobs where FlexiShift is not at fault."]}),(0,s.jsxs)(c,{children:['\n',"Chargebacks or payment reversals initiated by a Haulier (other than those caused by FlexiShift error) are the Haulier's sole responsibility. FlexiShift may recover chargeback amounts via set-off against future escrow releases. Abuse of the chargeback process may result in account suspension."]}),(0,s.jsxs)(c,{children:['\n',"FreightFlex fees are invoiced exclusive of Norwegian VAT and users are responsible for their own VAT obligations under local law."]})]}),(0,s.jsxs)(l,{title:"9. Disputes and Escrow Release",children:[(0,s.jsx)(c,{children:"FlexiShift does not bear responsibility for handling disputes. This must be addressed through appropriate legal channels. A corresponding rating of the experience must be given via the platform."}),(0,s.jsxs)(c,{children:['\n',"FlexiShift may deduct outstanding platform fees, commission, or cancellation charges from escrow before release where applicable."]}),(0,s.jsxs)(c,{children:['\n',"FlexiShift accepts no financial liability in connection with any dispute between Users. FlexiShift's involvement is an administrative convenience only and does not constitute a legal or arbitral award."]}),(0,s.jsxs)(c,{children:['\n',"Unresolved disputes may be referred to court, independent arbitration, the relevant insurer, or the Third-Party Payment Processor's own procedure. FlexiShift will provide access to Platform evidence records on receipt of a valid legal request."]})]}),(0,s.jsxs)(l,{title:"10. Privacy, GPS Tracking, and Data Processing",children:[(0,s.jsx)(c,{children:"FlexiShift processes personal data in accordance with its Privacy Policy (available on the Platform and incorporated by reference). By using the Platform, Users consent to data processing as described therein. Key points:"}),(0,s.jsx)(u,{children:"Drivers consent to real-time GPS location tracking (polling every 10\u201315 seconds) during active Jobs. Location data is shared with the relevant Haulier and Firm in real time and can be retained for up to 24 months for dispute and compliance purposes."}),(0,s.jsx)(u,{children:"GPS data may be shared with insurers, law enforcement, or arbitrators on request."}),(0,s.jsx)(u,{children:"Verification documents, delivery photographs, digital signatures, and compliance data are stored securely and can be retained for up to 24 months."}),(0,s.jsx)(u,{children:"Job data may be shared with the Third-Party Payment Processor (fraud prevention), insurers (claims handling), regulatory authorities (legal requirement), and in anonymised form for Platform analytics."}),(0,s.jsx)(u,{children:"Drivers must not disable GPS or location services during an active Job. Deliberate disabling may result in account action."}),(0,s.jsx)(u,{children:"Users may exercise their data rights (access, correction, deletion, portability, objection) as set out in the Privacy Policy and in accordance with Applicable Law."})]}),(0,s.jsxs)(l,{title:"11. Platform Rules \u2013 Ratings, Reviews, and the Driver App",children:[(0,s.jsxs)(h,{title:"11.1 Ratings and Reviews",children:[(0,s.jsx)(u,{children:"One rating per completed Job per counterparty. Ratings must be honest and based on genuine experience of that specific Job."}),(0,s.jsx)(u,{children:"Reviews must not be defamatory, abusive, discriminatory, fake, manipulated, or incentivised."}),(0,s.jsx)(u,{children:"FlexiShift may remove or decline to publish any review at its discretion and accepts no liability for inaccurate reviews."}),(0,s.jsx)(u,{children:"Ratings feed the Smart Matching Engine and affect Supplier visibility, job eligibility, and continued Platform access. Accounts falling below acceptable rating thresholds may be suspended."})]}),(0,s.jsxs)(h,{title:"11.2 Driver App \u2013 Device and Safe Use",children:[(0,s.jsx)(c,{children:"The Driver app requires: GPS/location (always-on during active Jobs); camera; push notifications; and storage. Disabling required permissions during a Job may impair functionality and constitute a breach."}),(0,s.jsx)(u,{children:"Drivers must not interact with the app in a manner that is unsafe or unlawful while driving. All active in-app interactions during transit must be completed only when the vehicle is safely stationary."}),(0,s.jsx)(u,{children:"Drivers are responsible for ensuring their device is charged and connected throughout a Job. FlexiShift accepts no liability for failures caused by device issues, battery, or poor connectivity."}),(0,s.jsx)(u,{children:"Software updates must be installed promptly. FlexiShift accepts no liability for errors arising from outdated app versions."}),(0,s.jsx)(u,{children:"Where the app is distributed through an app store, that store's terms apply in addition to these Terms and take precedence in respect of app distribution only."})]})]}),(0,s.jsx)(l,{title:"12. Platform Changes and Service Providers",children:(0,s.jsx)(c,{children:"FlexiShift reserves the right at any time to modify, enhance, discontinue, or replace any feature or functionality; change or terminate any third-party service provider (including the Third-Party Payment Processor); and update pricing or commission structures with reasonable notice. FlexiShift shall not be liable for any loss arising from such changes. Material changes to these Terms will be notified by email or in-platform notification; continued use constitutes acceptance."})}),(0,s.jsx)(l,{title:"13. Intellectual Property",children:(0,s.jsx)(c,{children:"All intellectual property in the Platform (software, design, algorithms, branding, trademarks, and content) is owned by or licensed to AI Planning Ltd UK. Users receive a limited, non-exclusive, non-transferable licence to use the Platform for its intended purpose only. Users may not copy, reverse-engineer, modify, or distribute any Platform element without prior written consent."})}),(0,s.jsxs)(l,{title:"14. Limitation of Liability, Indemnity, and Termination",children:[(0,s.jsx)(h,{title:"14.1 Limitation of Liability",children:(0,s.jsx)(c,{children:"To the fullest extent permitted by Applicable Law, FlexiShift's aggregate liability to any User is capped at the total platform fees paid by that User in the three months preceding the relevant claim. FlexiShift is not liable for indirect, consequential, incidental, special, or punitive loss, including loss of profit, revenue, data, or goodwill. Nothing herein limits liability for death or personal injury caused by FlexiShift's negligence, fraud, or any other head of liability that cannot be excluded under Applicable Law."})}),(0,s.jsxs)(h,{title:"14.2 User Indemnity",children:[(0,s.jsx)(c,{children:"Each User indemnifies FlexiShift, its directors, officers, and affiliates against all claims, losses, penalties, and costs (including legal fees) arising from:"}),(0,s.jsx)(u,{children:"Breach of these Terms"}),(0,s.jsx)(u,{children:"Violation of Applicable Law"}),(0,s.jsx)(u,{children:"Acts or omissions in connection with any Job"}),(0,s.jsx)(u,{children:"Third-party claims for goods lost, stolen, or damaged in connection with a Job"}),(0,s.jsx)(u,{children:"Failure to maintain adequate insurance"}),(0,s.jsx)(u,{children:"Posting or transporting Prohibited Goods"})]}),(0,s.jsxs)(h,{title:"14.3 Suspension and Termination",children:[(0,s.jsx)(c,{children:"FlexiShift may suspend or terminate any account without prior notice for:"}),(0,s.jsx)(u,{children:"Breach of these Terms"}),(0,s.jsx)(u,{children:"False or misleading information"}),(0,s.jsx)(u,{children:"Unlawful or harmful conduct"}),(0,s.jsx)(u,{children:"Lapsed insurance or verification documents"}),(0,s.jsx)(u,{children:"Failure to satisfy KYC/KYB/sanctions checks"}),(0,s.jsx)(u,{children:"As required by law or court order"}),(0,s.jsxs)(c,{children:['\n',"Outstanding escrow funds will be handled in accordance with the relevant Job status and the Third-Party Payment Processor's procedures."]})]})]}),(0,s.jsx)(l,{title:"16. General",children:[['Entire Agreement','These Terms constitute the entire agreement between FlexiShift and each User regarding use of the Platform.'],['Severability','Invalid or unenforceable provisions will be modified to the minimum extent necessary; remaining provisions remain in full force.'],['Waiver','Failure to enforce any provision is not a waiver of the right to enforce it in future.'],['Assignment','FlexiShift may assign its rights and obligations to any successor entity. Users may not assign without prior written consent.'],['Language','These Terms are issued in English. Norwegian and Swedish translations are available on request. In the event of conflict, the English version prevails except where Applicable Law requires otherwise.'],['Notices','Formal notices to FlexiShift should be sent to the contact address published on the Platform.']].map(function(t){var l=(0,n.default)(t,2),c=l[0],h=l[1];return(0,s.jsxs)(o.View,{style:f.generalRow,children:[(0,s.jsxs)(o.Text,{style:f.generalHeading,children:[c,":"]}),(0,s.jsx)(o.Text,{style:f.generalText,children:h})]},c)})}),(0,s.jsxs)(o.View,{style:f.footer,children:[(0,s.jsx)(o.Text,{st