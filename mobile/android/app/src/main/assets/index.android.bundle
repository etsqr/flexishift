n law"}),(0,n.jsx)(s,{children:"Google Maps: for route display and address validation within the app"}),(0,n.jsx)(s,{children:"Cloud infrastructure providers: for hosting and data storage"}),(0,n.jsx)(s,{children:"Analytics providers: for platform performance monitoring"}),(0,n.jsx)(o.Text,{style:l.subTitle,children:"5.3 With regulatory and legal authorities"}),(0,n.jsx)(o.Text,{style:l.body,children:"We may share personal data with tax authorities (including HMRC, Skatteverket in Sweden, and Skatteetaten in Norway), law enforcement, or other regulatory bodies where we are legally required to do so."}),(0,n.jsx)(o.Text,{style:l.subTitle,children:"5.4 In the event of a business transfer"}),(0,n.jsx)(o.Text,{style:l.body,children:"If AI Planning Ltd is acquired, merged, or transfers its business, personal data held on the platform may be transferred as part of that transaction. We will notify affected users in advance where required by law."})]}),(0,n.jsxs)(o.View,{style:l.card,children:[(0,n.jsx)(o.Text,{style:l.sectionTitle,children:"6. International Data Transfers"}),(0,n.jsx)(o.Text,{style:l.body,children:"AI Planning Ltd is based in the United Kingdom. Where we transfer personal data outside the UK or the European Economic Area (EEA), we ensure appropriate safeguards are in place, including:"}),(0,n.jsx)(s,{children:"UK International Data Transfer Agreements (IDTAs) for transfers from the UK"}),(0,n.jsx)(s,{children:"EU Standard Contractual Clauses (SCCs) for transfers from Sweden or Norway under EU GDPR"}),(0,n.jsx)(s,{children:"Reliance on adequacy decisions where applicable"}),(0,n.jsxs)(o.Text,{style:l.body,children:['\n',"Stripe processes data in the United States and maintains appropriate transfer mechanisms including SCCs. Further details are available in Stripe's privacy policy."]})]}),(0,n.jsxs)(o.View,{style:l.card,children:[(0,n.jsx)(o.Text,{style:l.sectionTitle,children:"7. Data Retention"}),(0,n.jsx)(o.Text,{style:l.body,children:"We retain personal data for as long as is necessary for the purposes for which it was collected, subject to the following:"}),(0,n.jsx)(s,{children:"Active account data: retained for the duration of your account"}),(0,n.jsx)(s,{children:"Job and transaction records: retained for 7 years following the transaction to comply with tax and accounting obligations in the UK, Sweden, and Norway"}),(0,n.jsx)(s,{children:"KYC and identity verification documents: retained for 5 years following the end of the business relationship, in accordance with AML obligations"}),(0,n.jsx)(s,{children:"Location data from completed jobs: retained for 12 months then deleted"}),(0,n.jsx)(s,{children:"Incident reports and dispute records: retained for 3 years"}),(0,n.jsx)(s,{children:"Marketing preferences and consent records: retained until withdrawn plus 2 years"}),(0,n.jsxs)(o.Text,{style:l.body,children:['\n',"When data is no longer required, it is securely deleted or anonymised."]})]}),(0,n.jsxs)(o.View,{style:l.card,children:[(0,n.jsx)(o.Text,{style:l.sectionTitle,children:"8. Your Rights"}),(0,n.jsx)(o.Text,{style:l.body,children:"Depending on your location and the applicable data protection law, you have the following rights in relation to your personal data:"}),(0,n.jsx)(s,{children:"Right of access: to receive a copy of the personal data we hold about you"}),(0,n.jsx)(s,{children:"Right to rectification: to have inaccurate personal data corrected"}),(0,n.jsx)(s,{children:"Right to erasure: to request deletion of your personal data in certain circumstances"}),(0,n.jsx)(s,{children:"Right to restriction: to restrict how we process your data in certain circumstances"}),(0,n.jsx)(s,{children:"Right to data portability: to receive your data in a structured, machine-readable format"}),(0,n.jsx)(s,{children:"Right to object: to object to processing based on legitimate interests"}),(0,n.jsx)(s,{children:"Rights related to automated decision-making: our matching algorithm uses automated processing to suggest j